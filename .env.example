# Pulsar never enables live trading unless BOTH flags are set.
PULSAR_LIVE=false
PULSAR_LIVE_CONFIRM=

# Runtime
PULSAR_DATA_DIR=./data
PULSAR_DB_PATH=./data/pulsar.db
PULSAR_LOG_LEVEL=INFO
PULSAR_HOST=127.0.0.1
PULSAR_PORT=8000

# DecisionPort: rules (default) | llm | jev
PULSAR_DECISION_BACKEND=rules
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# Chat / researcher generation (OpenAI-compatible). Leave empty for deterministic copilot.
PULSAR_LLM_API_KEY=
PULSAR_LLM_BASE_URL=https://api.x.ai/v1
PULSAR_LLM_MODEL=grok-4

# ComputePort: local | grokbot
PULSAR_COMPUTE=local
PULSAR_MCP_TOKEN=
PULSAR_GROKBOT_SCOPE=paper

# Binance — default paper/sim. Testnet: https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Interactive Brokers — paper gateway only in v1 docs. Never put live keys on Grok Bot.
IBKR_ENABLED=false
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_PAPER=true

# Isolated risk books. Do not share one number across spot and futures.
PULSAR_SPOT_MAX_NOTIONAL_PCT=0.05
PULSAR_SPOT_MAX_DAILY_LOSS_PCT=0.02
PULSAR_SPOT_MAX_DRAWDOWN_PCT=0.08
PULSAR_FUTURES_MAX_NOTIONAL_PCT=0.02
PULSAR_FUTURES_MAX_DAILY_LOSS_PCT=0.01
PULSAR_FUTURES_MAX_DRAWDOWN_PCT=0.05
